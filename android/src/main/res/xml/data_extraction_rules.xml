<?xml version="1.0" encoding="utf-8"?>
<!-- AND-L5: Android 12+ではallowBackup="false"だけではデバイス間転送(D2D)が止まらない。
     暗号化済み秘密鍵(filesDir/keys)等はAndroid Keystore由来のKEKで暗号化しており、
     Keystoreは転送されないため移しても復号不能なゴミになる。クラウドバックアップ・
     デバイス間転送ともに全ドメインを除外する。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
