<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 9-4（実験的機能、既定OFF）: Wi-Fi/セルラー物理無線への同時マルチパスの
         ためのrequestNetwork()。プロファイルでオプトインしない限り実際には使われない。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- #25: BEL(端末ベル)受信時の触覚フィードバック。VIBRATEはnormal permissionで
         インストール時に自動付与され、ランタイム許可プロンプトは発生しない。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".IsekaiTerminalApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- foregroundServiceType は specialUse を使う。型選択の経緯:
             - dataSync/mediaProcessing/shortServiceには絶対に戻さない: Android 15+で
               バックグラウンド起動後の短時間強制終了・長時間セッションでの累積6時間
               クォータの対象になり、SSHセッションのように「接続している間ずっと
               生きているべき」用途に適さない(実機でクラッシュループを確認、
               2026-07-27、TerminalSessionService.kt参照)。
             - remoteMessagingは却下: Play Storeの用途定義が「テキストメッセージの
               中継」であり、SSHセッション保持という実態と一致しない。
             - connectedDeviceも却下: 前提権限がPhase 9-4の実験的機能
               (CHANGE_NETWORK_STATE)頼みになり、将来その権限を外すと
               SecurityExceptionになる隠れた結合を生む。
             - specialUseはAndroid 15/16/17いずれでもタイムアウト対象外であることを
               Web調査で確認済み。PROPERTY_SPECIAL_USE_FGS_SUBTYPEで用途を明示する。
             2026-07-27のクラッシュループの本質的な修正は型ではなく
             onStartCommandのnull Intentガードであり、型変更でこの修正が失われる
             ことはない(TerminalSessionService.kt参照)。 -->
        <service
            android:name=".TerminalSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-initiated interactive SSH/QUIC terminal sessions alive while the app is backgrounded. The session is an interactive remote shell explicitly started by the user; terminating it loses unsaved remote work. No other foreground service type applies." />
        </service>
        <!-- クリップボード画像同期(`ISEKAI_PIPE_DESIGN.md` §8 Epic M follow-up)用。
             リモートから受け取ったPNGを一時ファイルとして書き出し、他アプリの
             ペースト操作から読める content:// URI を発行するためだけに使う。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="tools.isekai.terminal.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
