{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-agent-merge.py\" || exit 0; python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-agent-merge.py\"",
            "timeout": 10,
            "statusMessage": "worktreeエージェントの権限チェック"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/cargo_check_on_edit.py",
            "async": true,
            "asyncRewake": true,
            "rewakeMessage": "cargo build reported warnings/errors after your last edit to a rust-core file:\n",
            "rewakeSummary": "cargo build warnings/errors",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
